<?xml version="1.0" encoding="utf-8"?>
<!--
  Custom theme for SC Bridge Suite bundle.
  Based on WiX 4 HyperlinkTheme, extended with two component-selection checkboxes
  on the Install page that bind to the InstallCompanion and InstallHud bundle variables.
  Checkbox<->Variable binding is automatic when the Checkbox Name matches a Variable Name.
-->
<Theme xmlns="http://wixtoolset.org/schemas/v4/thmutil">
  <Window Width="485" Height="320" HexStyle="100a0000" FontId="0">#(loc.Caption)</Window>

  <Font Id="0" Height="-12" Weight="500" Foreground="windowtext" Background="window">Segoe UI</Font>
  <Font Id="1" Height="-24" Weight="500" Foreground="windowtext">Segoe UI</Font>
  <Font Id="2" Height="-22" Weight="500" Foreground="graytext">Segoe UI</Font>
  <Font Id="3" Height="-12" Weight="500" Foreground="windowtext" Background="window">Segoe UI</Font>

  <ImageControl Name="Logo" X="11" Y="11" Width="64" Height="64" ImageFile="bundle-logo.png" Visible="yes" />

  <Page Name="Help">
    <Label X="85" Y="11" Width="-11" Height="32" FontId="1" DisablePrefix="yes">#(loc.HelpHeader)</Label>
    <Label X="11" Y="85" Width="-11" Height="-35" FontId="3" DisablePrefix="yes">#(loc.HelpText)</Label>
    <Button Name="HelpCloseButton" X="-11" Y="-11" Width="85" Height="27" TabStop="yes" FontId="0">#(loc.HelpCloseButton)</Button>
  </Page>

  <Page Name="Install">
    <Label X="85" Y="11" Width="-11" Height="32" FontId="1" DisablePrefix="yes">#(loc.InstallHeader)</Label>
    <Label X="11" Y="85" Width="-11" Height="36" FontId="3" DisablePrefix="yes">#(loc.InstallMessage)</Label>

    <Label X="11" Y="125" Width="-11" Height="20" FontId="3" DisablePrefix="yes">#(loc.InstallChooseComponents)</Label>
    <Checkbox Name="InstallCompanion" X="22" Y="148" Width="-22" Height="20" TabStop="yes" FontId="3">#(loc.InstallCompanionLabel)</Checkbox>
    <Checkbox Name="InstallHud"       X="22" Y="172" Width="-22" Height="20" TabStop="yes" FontId="3">#(loc.InstallHudLabel)</Checkbox>

    <Hypertext Name="EulaHyperlink"     X="11" Y="-41" Width="-11"  Height="17" TabStop="yes" FontId="3" HideWhenDisabled="yes">#(loc.InstallLicenseLinkText)</Hypertext>
    <Checkbox  Name="EulaAcceptCheckbox" X="-11" Y="-41" Width="246" Height="17" TabStop="yes" FontId="3" HideWhenDisabled="yes">#(loc.InstallAcceptCheckbox)</Checkbox>

    <Button Name="OptionsButton"        X="-171" Y="-11" Width="85" Height="27" TabStop="yes" FontId="0" Visible="no">#(loc.InstallOptionsButton)</Button>
    <Button Name="InstallButton"        X="-91"  Y="-11" Width="85" Height="27" TabStop="yes" FontId="0">#(loc.InstallInstallButton)</Button>
    <Button Name="WelcomeCancelButton"  X="-11"  Y="-11" Width="85" Height="27" TabStop="yes" FontId="0">#(loc.InstallCloseButton)</Button>
  </Page>

  <Page Name="Modify">
    <Label X="85" Y="11" Width="-11" Height="32" FontId="1" DisablePrefix="yes">#(loc.ModifyHeader)</Label>
    <Button Name="RepairButton"       X="-171" Y="-11" Width="85" Height="27" TabStop="yes" FontId="0" HideWhenDisabled="yes">#(loc.ModifyRepairButton)</Button>
    <Button Name="UninstallButton"    X="-91"  Y="-11" Width="85" Height="27" TabStop="yes" FontId="0">#(loc.ModifyUninstallButton)</Button>
    <Button Name="ModifyCancelButton" X="-11"  Y="-11" Width="85" Height="27" TabStop="yes" FontId="0">#(loc.ModifyCloseButton)</Button>
  </Page>

  <Page Name="Progress">
    <Label X="85" Y="11" Width="-11" Height="32" FontId="1" DisablePrefix="yes">#(loc.ProgressHeader)</Label>
    <Label X="11" Y="121" Width="70" Height="17" FontId="3" DisablePrefix="yes">#(loc.ProgressLabel)</Label>
    <Label Name="OverallProgressPackageText" X="85" Y="121" Width="-11" Height="17" FontId="3" DisablePrefix="yes">#(loc.OverallProgressPackageText)</Label>
    <Progressbar Name="OverallCalculatedProgressbar" X="11" Y="143" Width="-11" Height="15" />
    <Button Name="ProgressCancelButton" X="-11" Y="-11" Width="85" Height="27" TabStop="yes" FontId="0">#(loc.ProgressCancelButton)</Button>
  </Page>

  <Page Name="Success">
    <Label X="85" Y="11" Width="-11" Height="32" FontId="1" DisablePrefix="yes">#(loc.SuccessHeader)</Label>
    <Label Name="SuccessHeader" X="85" Y="11" Width="-11" Height="32" FontId="1" DisablePrefix="yes" HideWhenDisabled="yes">#(loc.SuccessInstallHeader)</Label>
    <Button Name="LaunchButton"          X="-171" Y="-11" Width="85" Height="27" TabStop="yes" FontId="0" HideWhenDisabled="yes">#(loc.SuccessLaunchButton)</Button>
    <Button Name="SuccessRestartButton"  X="-91"  Y="-11" Width="85" Height="27" TabStop="yes" FontId="0" HideWhenDisabled="yes">#(loc.SuccessRestartButton)</Button>
    <Button Name="SuccessCancelButton"   X="-11"  Y="-11" Width="85" Height="27" TabStop="yes" FontId="0">#(loc.SuccessCloseButton)</Button>
  </Page>

  <Page Name="Failure">
    <Label X="85" Y="11" Width="-11" Height="32" FontId="1" DisablePrefix="yes">#(loc.FailureHeader)</Label>
    <Hypertext Name="FailureLogFileLink" X="11" Y="121" Width="-11" Height="42" FontId="3" TabStop="yes" HideWhenDisabled="yes">#(loc.FailureHyperlinkLogText)</Hypertext>
    <Hypertext Name="FailureMessageText" X="22" Y="163" Width="-11" Height="51" FontId="3" TabStop="yes" HideWhenDisabled="yes" />
    <Label Name="FailureRestartText"     X="-11" Y="-53" Width="400" Height="34" HexStyle="0x0001" FontId="3" HideWhenDisabled="yes">#(loc.FailureRestartText)</Label>
    <Button Name="FailureRestartButton"  X="-91" Y="-11" Width="85" Height="27" TabStop="yes" FontId="0" HideWhenDisabled="yes">#(loc.FailureRestartButton)</Button>
    <Button Name="FailureCloseButton"    X="-11" Y="-11" Width="85" Height="27" TabStop="yes" FontId="0">#(loc.FailureCloseButton)</Button>
  </Page>
</Theme>
